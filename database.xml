<?xml version="1.0" encoding="UTF-8"?>
<database>

    <!-- search fields -->
    <global execute="\\QUI\\Search::setup"></global>

    <projects>
        <table name="searchQuick" no-auto-update="1" no-site-reference="1">
            <field type="bigint" autoincrement="true" primary="true">id</field>
            <field type="bigint" nullable="true" default="NULL">siteId</field>
            <field type="text" nullable="true" default="NULL">urlParameter</field>
            <field type="text" nullable="true" default="NULL">data</field>
            <field type="text" nullable="true" default="NULL">rights</field>
            <field type="string" length="255" nullable="true" default="NULL">icon</field>
            <field type="string" length="255" nullable="true" default="NULL">siteType</field>
            <field type="bigint" nullable="true" default="NULL">custom_id</field>
            <field type="text" nullable="true" default="NULL">custom_data</field>
            <field type="string" length="255" nullable="true" default="NULL">origin</field>

            <index>siteId</index>
            <index>custom_id</index>
        </table>

        <table name="searchFull" no-auto-update="1" no-site-reference="1">
            <field type="bigint" autoincrement="true" primary="true">id</field>
            <field type="bigint" nullable="true" default="NULL">siteId</field>
            <field type="text" nullable="true" default="NULL">urlParameter</field>
            <field type="text" nullable="true" default="NULL">rights</field>
            <field type="string" length="255" nullable="true" default="NULL">datatype</field>
            <field type="string" length="255" nullable="true" default="NULL">icon</field>
            <field type="bigint" nullable="true" default="NULL">custom_id</field>
            <field type="text" nullable="true" default="NULL">custom_data</field>
            <field type="string" length="255" nullable="true" default="NULL">origin</field>

            <index>siteId</index>
            <index>custom_id</index>
        </table>

    </projects>

</database>
